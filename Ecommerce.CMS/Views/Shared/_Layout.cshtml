@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Http
﻿@using System.Security.Claims;
@using Project.Common.Models
@inject IStringLocalizer<SharedResource> Localizer
@{
    var currentCulture = Context.Request.Cookies[CookieRequestCultureProvider.DefaultCookieName];
    var isVi = currentCulture == null || currentCulture.Contains("vi-VN");
    var isEn = currentCulture != null && currentCulture.Contains("en-US");
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
    <style>
            :root{--nav:#172b4d;--nav2:#213b61;--blue:#1769d2;--bg:#f3f5f8;--line:#d9e0e8;--line2:#e8edf2;--text:#243247;--muted:#65748b;--font:"Segoe UI",Arial,sans-serif}
            *{box-sizing:border-box}
            html,body{margin:0;width:100%;height:100%;font:12px var(--font);color:var(--text);background:var(--bg)}

            /* Layout chính 1 cột dọc (Top-to-Bottom) */
            .app{height:100vh;min-height:540px;display:flex;flex-direction:column;overflow:hidden}

            /* Topbar trên cùng */
            .topbar{height:45px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:13px;padding:0 16px;flex-shrink:0}
            .brand{display:flex;align-items:center;gap:8px;margin-right:12px;text-decoration:none}
            .brand-icon{height:25px;width:25px;border-radius:4px;background:#2677d8;color:#fff;display:grid;place-items:center;font-weight:800;font-size:13px}
            .brand strong{font-size:12px;color:var(--text);line-height:1}
            .brand small{display:block;font-size:9px;color:var(--muted);margin-top:2px}
            .global-search{height:27px;border:1px solid var(--line);border-radius:4px;max-width:350px;width:30%;padding:0 9px;outline:none}
            .top-spacer{flex:1}
            .toplink{color:#52647d;font-size:11px;cursor:pointer;text-decoration:none}
            .avatar{width:26px;height:26px;border-radius:50%;background:#e1ecfb;color:#205ca7;display:grid;place-items:center;font-weight:700}

            /* Main Content Container */
            .main-container{min-width:0;display:flex;flex-direction:column;flex:1;overflow:hidden}
            .content-body{padding:12px 14px 10px;min-height:0;flex:1;display:flex;flex-direction:column;gap:8px;overflow:auto}

            /* Footer thu gọn tinh tế */
            .app-footer{height:30px;background:#fff;border-top:1px solid var(--line);display:flex;align-items:center;padding:0 16px;font-size:10px;color:var(--muted);flex-shrink:0}
    </style>
</head>
<body>
    <div class="app">
        <header class="topbar">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <div class="brand-icon">E</div>
                <div><strong>@Localizer["Layout_Brand_Subtitle"]</strong></div>
            </a>
            <input class="global-search" placeholder="@Localizer["Layout_GlobalSearch_Placeholder"]">
            <span class="top-spacer"></span>

            <!-- Form chọn ngôn ngữ -->
            @using (Html.BeginForm("SetLanguage", "Setting", new { returnUrl = returnUrl }, FormMethod.Post, antiforgery: true, htmlAttributes: new { @class = "d-inline-flex align-items-center" }))
            {
                @Html.DropDownList("culture", new List<SelectListItem>
                {
                    new SelectListItem { Text = "🇻🇳 Tiếng Việt", Value = "vi-VN", Selected = isVi },
                    new SelectListItem { Text = "🇬🇧 English", Value = "en-US", Selected = isEn }
                }, new { @class = "form-select form-select-sm", style = "width: auto; font-size: 11px;", onchange = "this.form.submit()" })
            }

            <a class="toplink" href="#">@Localizer["Layout_Footer_Help"]</a>
            <div class="avatar">NT</div>
            <span style="font-size:10px; font-weight:600;">@User.FindFirst(u => u.Type == ClaimTypes.Name)?.Value</p</span>
        </header>

        <!-- Gọi ViewComponent menu ngang theo JSON -->
        @await Component.InvokeAsync("MenuNav")

        <!-- Khu vực hiển thị View chính -->
        <div class="main-container">
            <main role="main" class="content-body">
                @RenderBody()
            </main>
        </div>

        <footer class="app-footer">
            <span>@Localizer["Layout_Footer_Copyright"]</span>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>