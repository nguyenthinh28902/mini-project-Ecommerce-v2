@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@using Project.Common.Models
@using Project.Common.Models.ViewModels.Auth
@inject IStringLocalizer<SharedResource> Localizer

@model SignInViewModel

@{
    Layout = null;
    ViewData["Title"] = @Localizer["Page_SystemAdmin_Title"];
}
@{
    var currentCulture = Context.Request.Cookies[CookieRequestCultureProvider.DefaultCookieName];
    var isVi = currentCulture == null || currentCulture.Contains("vi-VN");
    var isEn = currentCulture != null && currentCulture.Contains("en-US");
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- Nhúng Bootstrap 5 CSS nội bộ từ wwwroot/lib -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />

    <!-- CSS Tùy chỉnh màu .NET và giao diện -->
    <style>
            :root {
                --dotnet-purple: #512BD4;
                --dotnet-purple-hover: #4322b0;
                --dotnet-purple-light: #f4f2ff;
                --dotnet-purple-focus: rgba(81, 43, 212, 0.15);
            }

            .text-dotnet {
                color: var(--dotnet-purple) !important;
            }

                .text-dotnet:hover {
                    color: var(--dotnet-purple-hover) !important;
                }

            .btn-dotnet {
                background-color: var(--dotnet-purple);
                border-color: var(--dotnet-purple);
                transition: background-color 0.2s ease, transform 0.1s ease;
            }

                .btn-dotnet:hover {
                    background-color: var(--dotnet-purple-hover);
                    border-color: var(--dotnet-purple-hover);
                }

                .btn-dotnet:active {
                    transform: scale(0.98);
                }

            .login-container {
                width: 100%;
                max-width: 440px;
                padding: 15px;
            }

            .login-card {
                border-radius: 1rem;
                box-shadow: 0 10px 25px -5px rgba(81, 43, 212, 0.08), 0 8px 10px -6px rgba(81, 43, 212, 0.05) !important;
                border: 1px solid rgba(81, 43, 212, 0.1) !important;
            }

            .logo-badge {
                width: 56px;
                height: 56px;
                background-color: var(--dotnet-purple-light);
                color: var(--dotnet-purple);
                font-size: 24px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 0.75rem;
            }

            .input-group:focus-within {
                border-color: var(--dotnet-purple);
                box-shadow: 0 0 0 0.25rem var(--dotnet-purple-focus);
                border-radius: 0.375rem;
            }

                .input-group:focus-within .input-group-text,
                .input-group:focus-within .form-control {
                    border-color: var(--dotnet-purple) !important;
                }

            .cursor-pointer {
                cursor: pointer;
            }
    </style>
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100 position-relative">
    <div class="position-absolute top-0 end-0 p-3">
          <!-- Form chọn ngôn ngữ -->
            @using (Html.BeginForm("SetLanguage", "Setting", new { returnUrl = returnUrl }, FormMethod.Post, antiforgery: true, htmlAttributes: new { @class = "d-inline-flex align-items-center" }))
            {
                @Html.DropDownList("culture", new List<SelectListItem>
                {
                    new SelectListItem { Text = "🇻🇳 Tiếng Việt", Value = "vi-VN", Selected = isVi },
                    new SelectListItem { Text = "🇬🇧 English", Value = "en-US", Selected = isEn }
                }, new { @class = "form-select form-select-sm", style = "width: auto; font-size: 11px;", onchange = "this.form.submit()" })
            }
    </div>
    <div class="login-container">
        <div class="card login-card shadow-sm border-0">
            <div class="card-body p-4 p-sm-5">

                <!-- Header -->
                <div class="text-center mb-4">
                    <div class="logo-badge mb-3 mx-auto">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <h2 class="h4 fw-bold text-dark">@Localizer["Page_SystemAdmin_Title"]</h2>
                    <p class="text-muted small">@Localizer["Page_SystemAdmin_Description"]</p>
                    <p class="text-muted small mb-4">@Localizer[Model.SystemMessage]</p>
                </div>

                <!-- Form Login -->
                @using (Html.BeginForm("Index", "Auth", FormMethod.Post, new { id = "loginForm", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ReturnUrl)

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger p-2 mb-3 small">
                            @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                        </div>
                    }

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Id, new { @class = "form-label small fw-semibold" })
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted border-end-0">
                                <i class="bi bi-person"></i>
                            </span>
                            @Html.TextBoxFor(m => m.Id, new { @class = "form-control border-start-0 ps-0 shadow-none", placeholder = "Nhập tên đăng nhập..." })
                        </div>
                        @Html.ValidationMessageFor(m => m.Id, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label small fw-semibold" })
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted border-end-0">
                                <i class="bi bi-lock"></i>
                            </span>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control border-start-0 border-end-0 ps-0 shadow-none", placeholder = "••••••••", id = "password" })
                            <span class="input-group-text bg-white text-muted border-start-0 cursor-pointer" id="togglePassword">
                                <i class="bi bi-eye"></i>
                            </span>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <button type="submit" class="btn btn-dotnet w-100 py-2 fw-semibold text-white d-flex align-items-center justify-content-center gap-2">
                        <span>@Localizer["Button_SignIn_Now"]</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>
                }

                <!-- Footer -->
                <div class="text-center mt-4 small text-muted">
                    © 2026 Ecommerce CMS - Powered by <span class="text-dotnet fw-semibold">.NET</span>
                </div>

            </div>
        </div>
    </div>

    <!-- Nhúng các thư viện tĩnh nội bộ của .NET từ wwwroot/lib -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!-- JS tùy chỉnh ẩn/hiện mật khẩu -->
    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const togglePassword = document.getElementById('togglePassword');
                const passwordInput = document.getElementById('password');
                const iconEye = togglePassword.querySelector('i');

                togglePassword.addEventListener('click', function () {
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);

                    if (type === 'text') {
                        iconEye.classList.remove('bi-eye');
                        iconEye.classList.add('bi-eye-slash');
                    } else {
                        iconEye.classList.remove('bi-eye-slash');
                        iconEye.classList.add('bi-eye');
                    }
                });
            });
    </script>
</body>
</html>